{
  "schema_version": 2,
  "extends": "../common/deployment-parameters.json",
  "runtime_type": "llama",
  "notes": [
    "主线 Vulkan/RADV 引擎，设备默认为 Vulkan0。",
    "参数目录与 ROCm 共用；后端差异通过设备、驱动和 profile 表达。"
  ],
  "load_strategy": {
    "model_root": "/data/models",
    "binary_root": "/data/engines",
    "default": {"load_mode": "mmap", "fit": "on", "kv_cache": "q8_0"},
    "artifacts": ["model", "draft_model", "mmproj"]
  },
  "profiles": {
    "default": {"label": "Vulkan 通用默认", "parameters": {"device": "Vulkan0", "fit": "on", "k_cache_type": "q8_0", "v_cache_type": "q8_0"}},
    "concurrent_2": {"label": "双并发", "parameters": {"device": "Vulkan0", "concurrency": 2, "batch": 1024, "ubatch": 512}}
  }
}
