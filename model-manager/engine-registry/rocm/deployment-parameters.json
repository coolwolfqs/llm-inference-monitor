{
  "schema_version": 2,
  "extends": "../common/deployment-parameters.json",
  "runtime_type": "llama",
  "match": {"formats": ["GGUF"]},
  "notes": [
    "ROCm 主线引擎，设备默认为 ROCm0。",
    "模型、草稿模型和视觉投影文件均从 /data/models 解析；二进制路径只接受 VERSION.json。"
  ],
  "load_strategy": {
    "model_root": "/data/models",
    "binary_root": "/data/engines",
    "default": {"load_mode": "mmap", "fit": "on", "kv_cache": "q8_0"},
    "artifacts": ["model", "draft_model", "mmproj"]
  },
  "profiles": {
    "default": {"label": "ROCm 通用默认", "parameters": {"device": "ROCm0", "fit": "on", "k_cache_type": "q8_0", "v_cache_type": "q8_0"}},
    "concurrent_2": {"label": "双并发", "parameters": {"device": "ROCm0", "concurrency": 2, "batch": 1024, "ubatch": 512}}
  }
}
