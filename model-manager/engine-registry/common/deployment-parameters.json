    {"key":"v_cache_type","label":"V Cache","type":"select","flag":"--cache-type-v","values":["f32","f16","bf16","q8_0","q4_0","q4_1","iq4_nl","q5_0","q5_1"],"default":"q8_0","group":"KV Cache","managed":true},
    {"key":"draft_k_cache_type","label":"Draft K Cache","type":"select","flag":"--cache-type-k-draft","values":["f32","f16","bf16","q8_0","q4_0","q4_1","iq4_nl","q5_0","q5_1"],"default":"q8_0","group":"KV Cache","managed":true},
