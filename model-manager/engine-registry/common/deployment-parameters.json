{
  "schema_version": 2,
  "runtime_type": "llama",
  "notes": [
    "公共参数目录来自 llama.cpp llama-server --help；引擎文件只覆盖能力、默认值和 profile。",
    "q8_0 是模型中心的 KV Cache 默认值，实际可选值仍以二进制探测结果为准。"
  ],
  "parameters": [
    {"key":"ctx_size","label":"上下文大小","type":"integer","flag":"--ctx-size","min":4096,"max":1048576,"default":131072,"group":"基础","managed":true},
    {"key":"ngl","label":"GPU 层数","type":"integer","flag":"-ngl","min":0,"max":999,"default":99,"group":"加载","managed":true},
    {"key":"concurrency","label":"并发数","type":"integer","flag":"-np","min":1,"max":32,"default":1,"group":"基础","managed":true},
    {"key":"batch","label":"Batch","type":"integer","flag":"-b","min":1,"max":65536,"default":1024,"group":"性能","managed":true},
    {"key":"ubatch","label":"Ubatch","type":"integer","flag":"-ub","min":1,"max":65536,"default":512,"group":"性能","managed":true},
    {"key":"threads","label":"CPU 线程","type":"integer","flag":"-t","min":1,"max":512,"default":8,"group":"性能","managed":true},
    {"key":"threads_batch","label":"批处理线程","type":"integer","flag":"--threads-batch","min":1,"max":512,"default":null,"group":"性能"},
