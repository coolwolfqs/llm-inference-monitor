# Public deployment paths; secrets stay in the existing protected control-plane env.
MODEL_MANAGER_APP_DIR=/opt/model-manager/current
MODEL_MANAGER_MODELS_DIR=/data/models
MODEL_MANAGER_ENGINE_DIR=/data/engines
MODEL_MANAGER_STATE_DIR=/data/inference-hub/state
MODEL_MANAGER_CATALOG_DATABASE=/data/model-manager/catalog.sqlite3
MODEL_MANAGER_CONTROL_PORT=8093
MODEL_MANAGER_INFERENCE_CGROUP_PROCS=/sys/fs/cgroup/system.slice/inference-server.service/cgroup.procs
MODEL_MANAGER_RUNTIME_POLL_SECONDS=1
MODEL_MANAGER_LLAMA_ENV_FILE=/data/llama-server-config/llama-server.env
MODEL_MANAGER_LLAMA_START_SCRIPT=/usr/local/bin/start-llama-server.sh
MODEL_MANAGER_WRITE_START_SCRIPT=/usr/local/bin/write-start-llama-server.sh
MODEL_MANAGER_METADATA_OVERRIDES=/data/model-manager/model-metadata-overrides.json
MODEL_MANAGER_CATALOG_TTL_SECONDS=60
MODEL_MANAGER_INFERENCE_HOST=127.0.0.1
MODEL_MANAGER_INFERENCE_PORT=8080
